{
  "name": "lemmascript-dafny-benchmark-runs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Reproducible Claude Code runs against lemmascript-dafny-benchmark",
  "scripts": {
    "list": "node run.mjs --list",
    "plan": "node run.mjs --dry-run",
    "run": "node run.mjs",
    "reconcile": "node run.mjs --reconcile",
    "usage": "node usage-report.mjs",
    "skills": "node skill-report.mjs",
    "locs": "node locs-report.mjs",
    "results:push": "uv run --script push-results.py",
    "test:results": "python3 -B -m unittest discover -s test -p '*_test.py'",
    "test": "node --test"
  }
}
